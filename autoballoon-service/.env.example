# AutoBalloon service for PPAP — copy to .env (git-ignored).
#
# Vendored from https://github.com/smorx-demo/Autoballooning-with-versions
# (backend/, commit ce94647). PPAP's Design Records page talks to it only
# through the PPAP route /api/ppap/[id]/autoballoon/... using the super-admin
# account below, so users never see this service's own login.

# Leave DATABASE_URL unset to use the local JSON store + files in ./data.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

JWT_SECRET=replace-with-a-random-secret
PWD_PEPPER=replace-with-a-random-secret

# The account PPAP logs in as. Must match AUTOBALLOON_USERNAME /
# AUTOBALLOON_PASSWORD in the PPAP .env. Only used to seed a fresh ./data store.
SUPERADMIN_USERNAME=ppap-service
SUPERADMIN_EMAIL=ppap-service@localhost
SUPERADMIN_NAME=PPAP service account
SUPERADMIN_PASSWORD=replace-with-the-service-password

CORS_ORIGINS=http://localhost:3000

# Optional S3 storage for the PDFs (leave unset for local ./data files).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# Optional AI fallback for dimensions the PDF text reader misses (off by default).
# SMORX_AI_FALLBACK=1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
